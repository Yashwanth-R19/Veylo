# ═══════════════════════════════════════════════
# Veylo — Environment Configuration
# ═══════════════════════════════════════════════
# Copy to .env and fill in your values. Nothing in this file is committed
# with a real value anywhere in git history — see docs/EVALUATION.md's
# security audit.

# ─── Server ────────────────────────────────────
PORT=3000

# ─── Auth ───────────────────────────────────────
# Required — no hardcoded fallback. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Google sign-in (alongside email/password, not a replacement for it).
# Optional — POST /auth/google returns 503 until this is set, everything
# else works without it. Create at console.cloud.google.com: APIs &
# Services -> OAuth consent screen (External, add email/profile/openid
# scopes) -> Credentials -> Create Credentials -> OAuth client ID -> Web
# application -> Authorized JavaScript origins: http://localhost:5173 and
# http://localhost:5174 for local dev, plus the production frontend URL
# once deployed. No redirect URI and no client secret needed for this flow
# — the frontend gets a signed ID token directly from Google
# (@react-oauth/google) and this backend verifies it against Google's own
# public keys (google-auth-library) rather than trusting anything the
# client claims. Same value also goes in frontend/.env as
# VITE_GOOGLE_CLIENT_ID (see frontend/.env.example) — it's a public client
# identifier, not a secret, safe to ship in the frontend bundle.
GOOGLE_CLIENT_ID=

# ─── Database ───────────────────────────────────
# Postgres (§4's locked decision: "SQLite locally -> Neon Postgres at Phase
# 5" — the transition happens here). Two ways to get a Postgres connection
# string for local development:
#   1. Neon free tier (matches production exactly): create a project at
#      neon.tech, copy its connection string.
#   2. Local Docker Postgres (no external account needed):
#        docker run -d --name veylo-postgres -e POSTGRES_PASSWORD=veylodev \
#          -e POSTGRES_DB=veylo -p 5433:5432 postgres:16-alpine
#      then: DATABASE_URL="postgresql://postgres:veylodev@localhost:5433/veylo"
# In production (Render), this is set in the Render dashboard to the Neon
# connection string, never committed here.
DATABASE_URL="postgresql://postgres:veylodev@localhost:5433/veylo"

# ─── Polygon Amoy ──────────────────────────────
# Public RPC (rpc-amoy.polygon.technology) was deprecated 17 Jul 2026 and no
# longer resolves at all — use an Alchemy app URL.
ALCHEMY_AMOY_URL=

# Pays gas for every relayed call (createAgreement/acceptCriteria) and every
# validator-only call (recordVerification/giveRuling/finalize/confirmSettlement).
# Also used to deploy the contracts.
DEPLOYER_PRIVATE_KEY=
VALIDATOR_PRIVATE_KEY=

# submitEvidence/clientDecision/raiseDispute are msg.sender-gated on-chain,
# with no signature-relay path — these testnet-only wallets submit those
# three directly from the correct address. Disclosed testnet simplification
# for one client/worker, not the general design (see docs/CURRENT_STATE.md,
# Phase 2 Session 2). Each needs its own small Amoy POL balance.
TEST_CLIENT_PRIVATE_KEY=
TEST_WORKER_PRIVATE_KEY=

# ─── Sandbox (E2B) ─────────────────────────────
# Deployed verification path. Hobby tier, no card required.
E2B_API_KEY=

# ─── AI advisory layer ─────────────────────────
# Provider-agnostic: Groq is primary whenever a Groq key is configured,
# Gemini Flash is the fallback whenever a Gemini key is configured. At least
# one is required for SEMANTIC criteria to produce anything but INCONCLUSIVE
# — see validator/ai/modelClient.js. Groq free tier: 30 RPM / 1,000
# requests/day / 100,000 tokens/day PER KEY.
#
# Single key: set GROQ_API_KEY / GEMINI_API_KEY.
# Multiple keys (rotates to the next on a rate-limit/auth error, to multiply
# the effective free-tier budget): set GROQ_API_KEYS / GEMINI_API_KEYS
# instead, comma-separated. The plural var takes precedence if both are set.
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEYS=
GEMINI_API_KEYS=

# ─── Docker sandbox (local dev only — E2B is the deployed path) ──
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1
SANDBOX_TIMEOUT=30
SANDBOX_IMAGE=veylo-sandbox:latest

# ─── Razorpay (optional — Phase 6, not built; see docs/FUTURE_FEATURES.md) ──
# Only relevant if/when RazorpayProvider is implemented. Unused today —
# SimulatedProvider is the only PaymentProvider this build has.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
