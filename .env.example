# ═══════════════════════════════════════════════
# blockchain-escrow — Environment Configuration
# ═══════════════════════════════════════════════
# Copy to .env and fill in your values.

# ─── Server ────────────────────────────────────
PORT=3000

# ─── Database ───────────────────────────────────
# SQLite locally (Phase 2 onward); Neon Postgres from Phase 5.
DATABASE_URL="file:./dev.db"

# ─── Blockchain ────────────────────────────────
SEPOLIA_RPC_URL=https://rpc.sepolia.org
DEPLOYER_PRIVATE_KEY=
VALIDATOR_PRIVATE_KEY=
ESCROW_CONTRACT_ADDRESS=

# ─── Polygon Amoy (Phase 2+) ───────────────────
# Public RPC (rpc-amoy.polygon.technology) was deprecated 17 Jul 2026 — use
# an Alchemy app URL. DEPLOYER_PRIVATE_KEY above pays gas to deploy and also
# acts as VALIDATOR_PRIVATE_KEY unless a separate validator key is set.
ALCHEMY_AMOY_URL=

# submitEvidence/clientDecision/raiseDispute are msg.sender-gated on-chain —
# testnet-only test wallets the backend holds directly for a full lifecycle
# test (see docs/CURRENT_STATE.md, Phase 2 Session 2). Not for production use.
TEST_CLIENT_PRIVATE_KEY=
TEST_WORKER_PRIVATE_KEY=

# ─── AI advisory layer (Phase 3) ──────────────
# Provider-agnostic: Groq is primary whenever GROQ_API_KEY is set, Gemini
# Flash is the fallback whenever GEMINI_API_KEY is set. At least one is
# required for SEMANTIC criteria to produce anything but INCONCLUSIVE —
# see validator/ai/modelClient.js. Groq free tier: 30 RPM / 1,000
# requests/day / 100,000 tokens/day for llama-3.3-70b-versatile.
GROQ_API_KEY=
GEMINI_API_KEY=

# ─── Sandbox (Docker) ─────────────────────────
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1
SANDBOX_TIMEOUT=30
SANDBOX_IMAGE=escrow-sandbox:latest

# ─── Scoring Weights (must sum to 1.0) ────────
WEIGHT_EXECUTION=0.40
WEIGHT_STRUCTURE=0.20
WEIGHT_LINT=0.20
WEIGHT_SEMANTIC=0.20

# ─── Scoring Thresholds ───────────────────────
THRESHOLD_PASS=75
THRESHOLD_DISPUTE=50
