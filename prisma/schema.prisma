generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  passwordHash  String?
  name          String?
  walletAddress String?  @unique

  // Not in the plan's §7 field list — kept because backend/routes/auth.js
  // (which the plan's Phase 2 "Reused" section says stays unchanged) reads
  // and writes all three. Added back per explicit user decision rather than
  // breaking auth.js or silently trimming its features.
  role          String   @default("client")
  oauthProvider String?
  oauthId       String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  agreementsAsClient Agreement[] @relation("AgreementClient")
  agreementsAsWorker Agreement[] @relation("AgreementWorker")
  disputesRaised     Dispute[]   @relation("DisputeRaisedBy")
}

model Agreement {
  id               Int      @id @default(autoincrement())
  onChainId        Int?     @unique

  clientId         Int
  client           User     @relation("AgreementClient", fields: [clientId], references: [id])
  workerId         Int
  worker           User     @relation("AgreementWorker", fields: [workerId], references: [id])

  title            String?
  description      String?

  amountMinor      BigInt
  currency         String

  criteriaHash     String
  criteriaJson     String // JSON-serialized: SQLite connector has no native Json type

  clientSignature  String?
  workerSignature  String?

  deadline         DateTime
  reviewWindowEnds DateTime?

  status           String   @default("DRAFT")
  outcome          String   @default("NONE")

  createdAt        DateTime @default(now())

  criteria         Criterion[]
  evidence         Evidence[]
  verifications    Verification[]
  disputes         Dispute[]
  settlement       Settlement?
  outboxEntries    Outbox[]
}

model Criterion {
  id          Int       @id @default(autoincrement())
  agreementId Int
  agreement   Agreement @relation(fields: [agreementId], references: [id])

  index       Int
  method      String
  text        String
  checkSpec   String? // JSON-serialized: SQLite connector has no native Json type

  @@unique([agreementId, index])
}

model Evidence {
  id           Int       @id @default(autoincrement())
  agreementId  Int
  agreement    Agreement @relation(fields: [agreementId], references: [id])

  repoUrl      String
  commitHash   String
  evidenceHash String

  submittedAt  DateTime  @default(now())
}

model Verification {
  id                Int       @id @default(autoincrement())
  agreementId       Int
  agreement         Agreement @relation(fields: [agreementId], references: [id])

  resultsHash       String?
  deterministicHash String?
  resultsJson       String? // JSON-serialized: SQLite connector has no native Json type

  outcome           String?
  engineVersion     String?

  startedAt         DateTime?
  finishedAt        DateTime?
  error             String?
}

model Dispute {
  id                Int       @id @default(autoincrement())
  agreementId       Int
  agreement         Agreement @relation(fields: [agreementId], references: [id])

  externalDisputeId Int?

  raisedById        Int
  raisedBy          User      @relation("DisputeRaisedBy", fields: [raisedById], references: [id])

  reason            String?
  ruling            Int?
  rulingHash        String?

  status            String    @default("RAISED")

  createdAt         DateTime  @default(now())
}

model Settlement {
  id               Int       @id @default(autoincrement())
  agreementId      Int       @unique
  agreement        Agreement @relation(fields: [agreementId], references: [id])

  decision         String
  idempotencyKey   String    @unique
  providerRef      String?

  intentRecordedAt DateTime  @default(now())
  executedAt       DateTime?

  status           String    @default("PENDING")
  attempts         Int       @default(0)
  lastError        String?
}

// Advisory-layer response cache (VEYLO_BUILD_PLAN_REVISED.md Phase 3, Part A:
// "cache aggressively, keyed on (commitHash, criterionIndex)"). Not in the
// plan's §7 field list — that list predates the AI layer. Added this session,
// flagged rather than silently inserted, per explicit user decision: the
// budget this exists to protect (Groq's 100k tokens/day free tier) must
// survive process restarts, which an in-memory-only cache would not on
// Render's free tier (documented elsewhere in the plan as sleeping after
// 15min idle).
//
// commitHash (Phase 3 Session 2 correction): despite the column name, the
// value written here is validator/advisory/AdvisoryValidator.js's
// computeRepoContentHash() output, not necessarily a literal git commit
// hash. Local filesystem fixtures (corpus/, corpus-adversarial/) always pass
// spec.commitHash: null, which would have made every fixture repo's
// criterion-0 cache entry collide with every other fixture's criterion-0
// entry. The column was kept as-is (no migration) since a content hash is a
// valid, strictly-correct value for it — same content, same cached answer —
// but the name is now a historical artifact, not a description of what's
// stored.
model AdvisoryCache {
  id                Int      @id @default(autoincrement())
  commitHash        String
  criterionIndex    Int

  status            String
  confidence        Float
  evidenceRefs      String // JSON-serialized array: SQLite connector has no native Json type
  explanation       String

  provider          String
  promptTokens      Int?
  completionTokens  Int?

  createdAt         DateTime @default(now())

  @@unique([commitHash, criterionIndex])
}

// The consistency layer. Every chain write goes through this table: the
// intent row is written in the same DB transaction as the business state
// change, before any chain call is made (see backend/services/outbox.js).
model Outbox {
  id            Int       @id @default(autoincrement())
  agreementId   Int
  agreement     Agreement @relation(fields: [agreementId], references: [id])

  action        String
  payload       String // JSON-serialized: SQLite connector has no native Json type

  status        String    @default("PENDING")
  attempts      Int       @default(0)

  txHash        String?
  blockNumber   Int?
  confirmations Int       @default(0)

  lastError     String?
  createdAt     DateTime  @default(now())
}
