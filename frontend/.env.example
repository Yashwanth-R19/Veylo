# Copy to frontend/.env and fill in your values.

# Google sign-in — same Client ID as the backend's GOOGLE_CLIENT_ID (see
# .env.example at the repo root for how to create it). This is the public
# client identifier, not a secret, so it's safe to ship in the frontend
# bundle — Vite only exposes vars prefixed VITE_ to client code.
VITE_GOOGLE_CLIENT_ID=
